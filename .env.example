# Copy to .env (never commit .env).
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=changeme123
DATA_DIR=./data

# M-Carbon Dashboard integration (Section 5 of the scope). Used by lib/dashboard.js
# to pull actual consumption and a suggested baseline automatically. Requires Node 18+.
# Mirae ESP reads the KOREAN dashboard (the Philippine one was dashboardph.mirae.m-carbonsolutions.com).
MCARBON_BASE_URL=http://dashboardko.mirae.m-carbonsolutions.com
MCARBON_PHONE=your-dashboard-phone-number
MCARBON_PASSWORD=your-dashboard-password
# Data calls are written against /api/iotphp/... . If the Korean dashboard serves them under another
# prefix (the error message "not JSON ... check MCARBON_API_PREFIX" means this), set it here.
# MCARBON_API_PREFIX=/api/iotphp
# Hours from UTC for the dashboard's "today" (Korea = 9, the default).
# MONITOR_TZ_OFFSET=9

# Live monitor page (/monitor.html).
#   mock = generated sample data, clearly labelled on the page (default)
#   live = read from the Korean M-Carbon Dashboard using the credentials above
MONITOR_MODE=live
# Won per kWh, for the 30-day cost estimate on the monitor page. 150 is a placeholder: set your tariff.
RATE_KRW_PER_KWH=150
CO2_KG_PER_KWH=0.785
POLL_MS=2000

# Online payments (PayMongo hosted checkout - GCash, cards, QR Ph...). Leave the secret key empty
# to switch online payment off; the "Pay online" button then never appears.
#   1. PayMongo dashboard -> Developers: copy the SECRET key (sk_test_... while testing, sk_live_... for real money).
#   2. Dashboard -> Webhooks: add https://YOUR-DOMAIN/api/online-payments/webhook, subscribe to
#      checkout_session.payment.paid, and copy that webhook's signing secret (whsk_...).
#      Test and live mode need separate webhooks.
#   3. APP_BASE_URL is where clients are sent back after paying (your public https address).
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
APP_BASE_URL=
# Payment methods offered at checkout (must be enabled in your PayMongo dashboard). Default: card,gcash,qrph
PAYMONGO_METHODS=card,gcash,qrph
# true = a PayMongo payment also counts as finance's confirmation (invoice unlocks immediately).
# false (default) = finance still confirms each payment on the bill page.
PAYMONGO_AUTO_CONFIRM=false

# Payment reminders (due soon / overdue) by email. Without SMTP_HOST and MAIL_FROM, reminders still show inside the system.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="M-Carbon Billing <billing@your-company.com>"
NOTIFY_DUE_SOON_DAYS=3
NOTIFY_OVERDUE_REPEAT_DAYS=7
# NOTIFICATIONS_ENABLED=false
# APP_TIMEZONE=Asia/Manila

# Electronic tax invoices (Bolta, https://bolta.io). Leave BOLTA_API_KEY empty to switch it off.
#   1. Sign up at bolta.io, create a workspace, then Developer Center -> API keys.
#      A test_ key never reaches the NTS and costs nothing; a live_ key issues real invoices and spends prepaid points.
#   2. Register Mirae ESP's own 공동인증서 in Bolta (web) - live issuing is impossible without it. The test key can use a test certificate.
#   3. Developer Center -> Webhooks: register https://YOUR-DOMAIN/api/bolta/webhook?token=<BOLTA_WEBHOOK_TOKEN>
#      (test and live need separate registrations). Use a long random string for the token.
BOLTA_API_KEY=
BOLTA_BASE_URL=
BOLTA_WEBHOOK_TOKEN=
# Optional: only accept the webhook from Bolta's published sender address.
# BOLTA_WEBHOOK_IPS=43.201.136.252
# How to read a bill's amount_billed: add (it is before VAT, +10%) | incl (VAT already included) | zero | free
BOLTA_VAT_MODE=add
# Mirae ESP as the supplier (공급자) printed on every invoice. Must match its business registration exactly.
BOLTA_SUPPLIER_BRN=
BOLTA_SUPPLIER_NAME=
BOLTA_SUPPLIER_REPRESENTATIVE=
BOLTA_SUPPLIER_EMAIL=
# BOLTA_SUPPLIER_CONTACT_NAME=
# BOLTA_SUPPLIER_ADDRESS=
# BOLTA_SUPPLIER_BUSINESS_TYPE=
# BOLTA_SUPPLIER_BUSINESS_ITEM=
