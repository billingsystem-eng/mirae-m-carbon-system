# Copy to .env (never commit .env).
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=changeme123
DATA_DIR=./data

# M-Carbon Dashboard integration (Section 5 of the scope). Used by lib/dashboard.js
# to pull actual consumption and a suggested baseline automatically. Requires Node 18+.
MCARBON_BASE_URL=http://dashboardph.mirae.m-carbonsolutions.com
MCARBON_PHONE=your-dashboard-phone-number
MCARBON_PASSWORD=your-dashboard-password

# Live monitor page (/monitor.html).
#   mock = generated sample data, clearly labelled on the page (default)
#   live = read from the M-Carbon Dashboard using the credentials above
MONITOR_MODE=live
RATE_PHP_PER_KWH=11.5
CO2_KG_PER_KWH=0.785
POLL_MS=2000

# Online payments (PayMongo hosted checkout - GCash, cards, QR Ph...). Leave the secret key empty
# to switch online payment off; the "Pay online" button then never appears.
#   1. PayMongo dashboard -> Developers: copy the SECRET key (sk_test_... while testing, sk_live_... for real money).
#   2. Dashboard -> Webhooks: add https://YOUR-DOMAIN/api/online-payments/webhook, subscribe to
#      checkout_session.payment.paid, and copy that webhook's signing secret (whsk_...).
#      Test and live mode need separate webhooks.
#   3. APP_BASE_URL is where clients are sent back after paying (your public https address).
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
APP_BASE_URL=
# Payment methods offered at checkout (must be enabled in your PayMongo dashboard). Default: card,gcash,qrph
PAYMONGO_METHODS=card,gcash,qrph
# true = a PayMongo payment also counts as finance's confirmation (invoice unlocks immediately).
# false (default) = finance still confirms each payment on the bill page.
PAYMONGO_AUTO_CONFIRM=false

# Payment reminders (due soon / overdue) by email. Without SMTP_HOST and MAIL_FROM, reminders still show inside the system.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="M-Carbon Billing <billing@your-company.com>"
NOTIFY_DUE_SOON_DAYS=3
NOTIFY_OVERDUE_REPEAT_DAYS=7
# NOTIFICATIONS_ENABLED=false
# APP_TIMEZONE=Asia/Manila
