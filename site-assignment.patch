 // --- User management (administrators only) ---
 
+// Which site (project) a client login can see. A login is assigned to one site; its client follows from it.
+// Older logins that only have a client (project_id NULL) still see that whole client until an admin picks a site.
+// Returns { clientId, projectId } or { error }.
+function resolveAssignment({ project_id, client_id }) {
+  if (project_id) {
+    const p = db.prepare('SELECT id, client_id FROM projects WHERE id = ?').get(project_id);
+    if (!p) return { error: 'That site does not exist.' };
+    return { clientId: p.client_id, projectId: p.id };
+  }
+  if (client_id) {
+    if (!db.prepare('SELECT 1 FROM clients WHERE id = ?').get(client_id)) return { error: 'That client does not exist.' };
+    return { clientId: Number(client_id), projectId: null };
+  }
+  return { clientId: null, projectId: null };
+}
